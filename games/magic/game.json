{
  "format": "open-table-game",
  "format_version": 1,
  "id": "magic",
  "name": "Magic: The Gathering",
  "default_card_back": "assets/default_card_back.png",
  "object_libraries": [
    "objects/cards.json"
  ],
  "actions": {
    "take_card": {
      "label": "Take card",
      "handler": "take_card",
      "requires": [
        "has_cards"
      ]
    },
    "draw_private": {
      "label": "Draw private",
      "handler": "draw_private",
      "requires": [
        "has_cards"
      ]
    },
    "toggle_spread": {
      "label": "Spread",
      "alternate_label": "Collapse",
      "handler": "toggle_spread",
      "requires": [
        "spreadable"
      ],
      "full_label": "Fully spread"
    },
    "flip": {
      "label": "Flip",
      "handler": "flip",
      "requires": [
        "has_cards",
        "card_like"
      ]
    },
    "toggle_tapped": {
      "label": "Tap",
      "alternate_label": "Untap",
      "handler": "toggle_tapped",
      "requires": [
        "has_cards",
        "card_like"
      ]
    },
    "rotate_clockwise": {
      "label": "Rotate 90°",
      "handler": "rotate_clockwise",
      "requires": [
        "has_cards",
        "card_like"
      ]
    },
    "shuffle": {
      "label": "Shuffle",
      "handler": "shuffle",
      "requires": [
        "multiple_cards"
      ]
    },
    "take_top": {
      "label": "Take top card",
      "handler": "take_top",
      "requires": [
        "has_cards"
      ]
    },
    "rename_stack": {
      "label": "Rename stack…",
      "handler": "rename"
    },
    "delete_object": {
      "label": "Delete",
      "handler": "delete"
    },
    "card_counter_plus": {
      "label": "+1 on card",
      "handler": "card_counter_plus",
      "requires": [
        "has_cards",
        "card_like"
      ]
    },
    "card_counter_minus": {
      "label": "−1 on card",
      "handler": "card_counter_minus",
      "requires": [
        "has_cards",
        "card_like"
      ]
    }
  },
  "object_types": {
    "card": {
      "actions": [
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "card_counter_plus",
        "card_counter_minus",
        "delete_object"
      ],
      "schema": "card",
      "collection_actions": [
        "take_card",
        "toggle_spread",
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "shuffle",
        "card_counter_plus",
        "card_counter_minus",
        "rename_stack",
        "generic_collection_summary",
        "delete_object"
      ]
    },
    "token": {
      "actions": [
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "card_counter_plus",
        "card_counter_minus",
        "delete_object"
      ],
      "schema": "token",
      "collection_actions": [
        "take_card",
        "toggle_spread",
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "shuffle",
        "card_counter_plus",
        "card_counter_minus",
        "rename_stack",
        "generic_collection_summary",
        "delete_object"
      ]
    }
  },
  "stack_profiles": {
    "library": {
      "actions": [
        "draw_private",
        "shuffle",
        "toggle_spread",
        "take_top",
        "rename_stack",
        "generic_collection_summary",
        "delete_object"
      ]
    },
    "hand": {
      "actions": [
        "take_card",
        "toggle_spread",
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "card_counter_plus",
        "card_counter_minus",
        "rename_stack",
        "generic_collection_summary",
        "delete_object"
      ]
    },
    "graveyard": {
      "actions": [
        "take_card",
        "toggle_spread",
        "flip",
        "toggle_tapped",
        "rotate_clockwise",
        "shuffle",
        "card_counter_plus",
        "card_counter_minus",
        "rename_stack",
        "generic_collection_summary",
        "delete_object"
      ]
    }
  },
  "default_setup": "setups/default_table.json",
  "setups": [
    {
      "name": "Standard table",
      "path": "setups/default_table.json",
      "id": "default_table"
    }
  ],

  "object_schemas": {
    "card": {
      "renderer": "card",
      "fields": {
        "name": {
          "type": "string",
          "default": "Card",
          "required": true
        },
        "mana_cost": {
          "type": "string",
          "default": ""
        },
        "type_line": {
          "type": "string",
          "default": "Card"
        },
        "oracle_text": {
          "type": "string",
          "default": ""
        },
        "power": {
          "type": "string",
          "default": ""
        },
        "toughness": {
          "type": "string",
          "default": ""
        },
        "color": {
          "type": "string",
          "default": "C"
        },
        "art_label": {
          "type": "string",
          "default": ""
        },
        "front_image": {
          "type": "string",
          "default": ""
        },
        "back_image": {
          "type": "string",
          "default": ""
        },
        "set_code": {
          "type": "string",
          "default": ""
        },
        "collector_number": {
          "type": "string",
          "default": ""
        },
        "is_token": {
          "type": "bool",
          "default": false
        },
        "mana_value": {
          "type": "number",
          "default": 0
        },
        "record_id": {
          "type": "string",
          "default": ""
        },
        "identifiers": {
          "type": "dictionary",
          "default": {}
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "finishes": {
          "type": "array",
          "default": [
            "nonfoil"
          ]
        },
        "finish": {
          "type": "string",
          "default": "nonfoil"
        }
      },
      "render": {
        "title": "name",
        "corner": "mana_cost",
        "corner_transform": "strip_braces",
        "subtitle": "type_line",
        "body": "oracle_text",
        "stats": [
          "power",
          "toughness"
        ],
        "stats_separator": "/",
        "colour": "color",
        "art_label": "art_label",
        "front_image": "front_image",
        "back_image": "back_image",
        "default_frame_colour": "#7A7D80",
        "colour_map": {
          "W": "#C7BF94",
          "U": "#3D7AB8",
          "B": "#4D4A57",
          "R": "#B34733",
          "G": "#3D874F",
          "C": "#7A7D80"
        },
        "frame_colour_rules": [
          {
            "field": "type_line",
            "contains": "Land",
            "colour": "#8F6D47"
          }
        ],
        "art_label_rules": [
          {
            "field": "type_line",
            "contains": "Creature",
            "label": "CREATURE"
          },
          {
            "field": "type_line",
            "contains": "Land",
            "label": "LAND"
          },
          {
            "field": "type_line",
            "contains": "Instant",
            "label": "INSTANT"
          },
          {
            "field": "type_line",
            "contains": "Sorcery",
            "label": "SORCERY"
          },
          {
            "field": "type_line",
            "contains": "Enchantment",
            "label": "ENCHANTMENT"
          },
          {
            "field": "type_line",
            "contains": "Artifact",
            "label": "ARTIFACT"
          }
        ],
        "default_art_label": "CARD"
      },
      "summary": {
        "namespace": "card",
        "default": {
          "mode": "count",
          "value_field": "",
          "filter": ""
        },
        "value_fields": [
          {
            "path": "card.mana_value",
            "label": "Mana value"
          }
        ],
        "field_aliases": {
          "type": {
            "source": "type_line",
            "transform": "lower"
          },
          "text": "oracle_text",
          "mana_value": "mana_value",
          "name": "name",
          "colour": "color",
          "set": "set_code",
          "record_id": "record_id",
          "language": "language",
          "finish": "finish",
          "collector_number": "collector_number"
        },
        "filter_language": "open_table_expression_v1",
        "examples": [
          "card.type.match(/(instant|sorcery)/) && card.mana_value >= 5",
          "card.mana_value >= 4"
        ]
      },
      "group": {
        "enabled": true,
        "family": "card",
        "ordered": true,
        "layouts": {
          "collapsed": {
            "renderer": "layered"
          },
          "spread": {
            "renderer": "overlapping_row"
          },
          "fully_spread": {
            "renderer": "separated_row"
          }
        },
        "default_layout": "collapsed"
      }

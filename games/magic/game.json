  ],
  "catalogues": {
    "decks": {
      "adapter": "collection_files",
      "label": "Deck catalogue",
      "directory": "decks",
      "seed_directory": "decklists",
      "id_field": "id",
      "deletion_record": "deleted_decks.json",
      "creation_category": "decks",
      "allow_import": true,
      "allow_restore": true,
      "import_label": "Import decklist…",
      "restore_label": "Restore bundled decks",
      "import_title": "Import Magic decklist",
      "import_filters": [
        "*.txt,*.json,*.dek,*.cod ; Magic decklists",
        "*.* ; All files"
      ],
      "empty_text": "No decks are currently stored in the Magic catalogue.",
      "restored_message": "Restored bundled Magic decks",
      "plain_text": {
        "ignored_sections": [
          "deck",
          "mainboard",
          "sideboard",
          "commander",
          "companion"
        ],

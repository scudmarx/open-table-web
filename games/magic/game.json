  "creation_catalog": {
    "categories": [
      {
        "id": "cards",
        "label": "Cards",
        "description": "Create an individual card from any installed Magic card package.",
        "catalog_kind": "records",
        "entries": [],
        "catalogue_id": "card_sets",
        "exclude_filter": {
          "is_token": true
        },
        "searchable": true,
        "search_placeholder": "Search cards by name, mana cost, type, rules text or set…",
        "empty_text": "No non-token Magic cards are installed.",
        "record_display": {
          "search_fields": [
            "name",
            "mana_cost",
            "type_line",
            "oracle_text",
            "power",
            "toughness",
            "set_code",
            "collector_number",
            "record_id"
          ],
          "lines": [
            {
              "template": "{mana_cost} • {type_line}",
              "required": [
                "type_line"
              ]
            },
            {
              "template": "{power}/{toughness}",
              "required": [
                "power",
                "toughness"
              ]
            },
            {
              "template": "{oracle_text}",
              "required": [
                "oracle_text"
              ],
              "max_length": 120
            },
            {
              "template": "{set_code} #{collector_number}",
              "required": [
                "set_code",
                "collector_number"
              ]
            }
          ]
        },
        "include_object_libraries": true
      },
      {
        "id": "tokens",
        "label": "Tokens",
        "description": "Create token cards supplied by installed Magic set packages.",
        "catalog_kind": "records",
        "entries": [
          {
            "id": "custom_token",
            "label": "Create custom token…",
            "description": "Create a token card with user-entered Magic characteristics.",
            "kind": "token",
            "object": {
              "object_type": "token",
              "name": "Token",
              "mana_cost": "",
              "type_line": "Token Creature",
              "oracle_text": "",
              "power": "1",
              "toughness": "1",
              "color": "C",
              "art_label": "TOKEN",
              "is_token": true,
              "mana_value": 0
            },
            "creation_form": {
              "title": "Create Magic token",
              "description": "Enter the token's printed characteristics. These describe the physical object; Open Table does not enforce game rules.",
              "confirm_label": "Create token",
              "fields": [
                {
                  "id": "name",
                  "label": "Name",
                  "type": "string",
                  "default": "Token",
                  "required": true,
                  "target": "object.name"
                },
                {
                  "id": "type",
                  "label": "Type line",
                  "type": "string",
                  "default": "Token Creature",
                  "required": true,
                  "target": "object.type_line"
                },
                {
                  "id": "power",
                  "label": "Power",
                  "type": "string",
                  "default": "1",
                  "target": "object.power"
                },
                {
                  "id": "toughness",
                  "label": "Toughness",
                  "type": "string",
                  "default": "1",
                  "target": "object.toughness"
                },
                {
                  "id": "rules",
                  "label": "Rules text",
                  "type": "multiline",
                  "default": "",
                  "height": 130,
                  "target": "object.oracle_text"
                }
              ],
              "allow_presets": true,
              "save_preset_default": true,
              "preset_label_template": "{name}",
              "preset_description_template": "{type} — {power}/{toughness} — {rules}"
            },
            "actions": [
              "flip",
              "toggle_tapped",
              "rotate_clockwise",
              "card_counter_plus",
              "card_counter_minus",
              "delete_object"
            ]
          }
        ],
        "catalogue_id": "card_sets",
        "filter": {
          "is_token": true
        },
        "searchable": true,
        "search_placeholder": "Search tokens by name, type, text, power, toughness or set…",
        "record_display": {
          "search_fields": [
            "name",
            "mana_cost",
            "type_line",
            "oracle_text",
            "power",
            "toughness",
            "set_code",
            "collector_number",
            "record_id"
          ],
          "lines": [
            {
              "template": "{type_line}",
              "required": [
                "type_line"
              ]
            },
            {
              "template": "{power}/{toughness}",
              "required": [
                "power",
                "toughness"
              ]
            },
            {
              "template": "{oracle_text}",
              "required": [
                "oracle_text"
              ],
              "max_length": 100
            },
            {
              "template": "{set_code} #{collector_number}",
              "required": [
                "set_code",
                "collector_number"
              ]
            }
          ]
        }
      },
      {
        "id": "decks",
        "label": "Decks",
        "description": "Create a deck in the chosen zone. Hidden and private zones use their game-defined collection slot; otherwise the cards form a loose stack.",
        "catalog_kind": "collections",
        "entries": [],
        "empty_text": "No decks are stored. Use the Magic menu in the top-right to import or manage decks.",
        "catalogue_id": "decks"
      }
    ]
  },

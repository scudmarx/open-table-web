{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentable.local/schemas/open-table-collection-bundle-v1.json",
  "title": "OpenTable collection contribution bundle v1",
  "type": "object",
  "required": ["format", "format_version", "collections"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "format": {
      "const": "open-table-collection-bundle"
    },
    "format_version": {
      "const": 1
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$",
        "description": "Package-relative path to a decklist JSON file. Absolute paths and parent-directory traversal are forbidden."
      }
    }
  },
  "additionalProperties": false
}
